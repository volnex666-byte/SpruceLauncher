# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
WEBSITE_ORIGINS=http://localhost:5173,https://sprucelauncher.com
SITE_URL=https://sprucelauncher.com

# ── Data stores ─────────────────────────────────────────────────────
# Production: run docker-compose.yml and set both URLs below.
DATABASE_URL=
REDIS_URL=
# Development without Docker: embedded Postgres via PGlite (ignored when DATABASE_URL is set)
PGLITE=1
PGLITE_DATA_DIR=.devdata/pg
AUTO_MIGRATE=1

# ── Secrets ─────────────────────────────────────────────────────────
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_PEPPER=
LAUNCHER_HMAC_SECRET=
# Dev-only OTP peek endpoint (used by scripts/smoke.mjs). Never set in production.
DEV_PEEK_TOKEN=
# 1 disables HMAC verification of launcher requests. Development only.
HMAC_DISABLED=0
# 1 auto-bans HWID on launcher scope violations. Keep 0 until soft-fail is tuned.
AUTO_BAN_ON_SCOPE_VIOLATION=0

# ── Email ───────────────────────────────────────────────────────────
# Empty SMTP_HOST => console transport (OTP printed to server log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SpruceLauncher <no-reply@sprucelauncher.com>
EMAIL_CHECK_MX=0
